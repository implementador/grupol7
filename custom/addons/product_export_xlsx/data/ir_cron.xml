<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">

    <record id="ir_cron_product_export" model="ir.cron">

        <field name="name">
            Product XLSX Export - Procesar pendientes
        </field>

        <field
            name="model_id"
            ref="model_product_export_xlsx"
        />

        <field name="state">code</field>

        <field name="code">
            model._cron_process_pending()
        </field>

        <field
            name="user_id"
            ref="base.user_root"
        />

        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>

    </record>

</odoo>
