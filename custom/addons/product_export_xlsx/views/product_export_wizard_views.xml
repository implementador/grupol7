<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_product_export_xlsx_wizard_form" model="ir.ui.view">
        <field name="name">product.export.xlsx.wizard.form</field>
        <field name="model">product.export.xlsx.wizard</field>
        <field name="arch" type="xml">

            <form string="Generar Excel de productos">

                <div class="alert alert-info" role="alert">
                    El reporte se generara en segundo plano.
                    Puede salir de esta pantalla y regresar al historial.
                </div>

                <footer>

                    <button
                        name="action_generate"
                        string="Generar reporte"
                        type="object"
                        class="btn-primary"
                    />

                    <button
                        string="Cancelar"
                        special="cancel"
                        class="btn-secondary"
                    />

                </footer>

            </form>

        </field>
    </record>

    <record id="action_product_export_xlsx_wizard" model="ir.actions.act_window">
        <field name="name">Generar Excel de productos</field>
        <field name="res_model">product.export.xlsx.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
