<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <!-- Forzamos el reemplazo del botón "Nota de cliente" -->
  <t t-extend="OrderlineCustomerNoteButton">
    <!-- En este template, el nodo raíz es un <div class="control-button"> -->
    <t t-jquery="div.control-button" t-operation="replace">
      <div class="control-button" t-on-click="onClick" role="img" aria-label="Cupón QR" title="Cupón QR">
        <i class="fa fa-qrcode"/>
        <span>Cupón QR</span>
      </div>
    </t>
  </t>
</templates>
