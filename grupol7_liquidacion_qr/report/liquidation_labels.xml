  <!-- Template: QR 60x50 con fecha, usuario y firma -->
  <template id="liq_label_qr_doc_big">
    <t t-call="web.basic_layout">
      <div class="page" style="width:60mm;height:50mm;box-sizing:border-box;padding:2mm;">
        <t t-foreach="docs" t-as="o">
          <div style="text-align:center;page-break-inside:avoid;display:inline-block;width:56mm;height:46mm">
            <img t-att-src="'/report/barcode/QR/' + ('LIQ/' + o.name) + '?width=520&amp;height=520'"
                 style="width:42mm;height:42mm"/>
            <div style="font-size:12pt;margin-top:1mm" t-esc="'LIQ/' + o.name"/>
            <div style="font-size:10pt" t-esc="(o.product_id.display_name or '')[:48]"/>
            <div style="font-size:12pt"><b t-esc="'$ %0.2f' % (o.clearance_price or 0.0)"/></div>

            <div style="font-size:9pt;margin-top:1mm"
                 t-esc="'Fec.: ' + (o.create_date.strftime('%d/%m/%Y') if o.create_date else '')"/>
            <div style="font-size:9pt" t-esc="'Gen.: ' + (o.create_uid.name or '')"/>

            <div style="border-top:1px solid #000;margin:3mm auto 0;width:40mm"></div>
            <div style="font-size:8pt">Firma</div>
          </div>
        </t>
      </div>
    </t>
  </template>

  <record id="action_liq_coupon_print_label_qr_big" model="ir.actions.report">
