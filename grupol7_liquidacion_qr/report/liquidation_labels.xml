<odoo>
  <!-- Paper formats -->
  <record id="paperformat_liq_label_30x25" model="report.paperformat">
    <field name="name">LIQ Label 30x25</field>
    <field name="default" eval="False"/>
    <field name="format">custom</field>
    <field name="page_width">30</field>
    <field name="page_height">25</field>
    <field name="orientation">Portrait</field>
    <field name="margin_top">1</field>
    <field name="margin_bottom">1</field>
    <field name="margin_left">1</field>
    <field name="margin_right">1</field>
    <field name="dpi">96</field>
  </record>

  <record id="paperformat_liq_letter" model="report.paperformat">
    <field name="name">LIQ Letter (Carta)</field>
    <field name="default" eval="False"/>
    <field name="format">custom</field>
    <field name="page_width">216</field>
    <field name="page_height">279</field>
    <field name="orientation">Portrait</field>
    <field name="margin_top">5</field>
    <field name="margin_bottom">5</field>
    <field name="margin_left">5</field>
    <field name="margin_right">5</field>
    <field name="dpi">96</field>
  </record>

  <!-- ACCIONES: usar ir.actions.report en lugar de <report> -->
  <record id="action_liq_coupon_print_label_qr" model="ir.actions.report">
    <field name="name">Etiqueta LIQ (QR)</field>
    <field name="model">liquidation.coupon</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">grupol7_liquidacion_qr.liq_label_qr_doc</field>
    <field name="paperformat_id" ref="paperformat_liq_label_30x25"/>
  </record>

  <record id="action_liq_coupon_print_label_code128" model="ir.actions.report">
    <field name="name">Etiqueta LIQ (Code128)</field>
    <field name="model">liquidation.coupon</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">grupol7_liquidacion_qr.liq_label_code128_doc</field>
    <field name="paperformat_id" ref="paperformat_liq_label_30x25"/>
  </record>

  <record id="action_liq_coupon_print_sheet_qr" model="ir.actions.report">
    <field name="name">Hoja Carta LIQ (QR, 2×)</field>
    <field name="model">liquidation.coupon</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">grupol7_liquidacion_qr.liq_sheet_qr_doc</field>
    <field name="paperformat_id" ref="paperformat_liq_letter"/>
  </record>

  <record id="action_liq_coupon_print_sheet_code128" model="ir.actions.report">
    <field name="name">Hoja Carta LIQ (Code128, 2×)</field>
    <field name="model">liquidation.coupon</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">grupol7_liquidacion_qr.liq_sheet_code128_doc</field>
    <field name="paperformat_id" ref="paperformat_liq_letter"/>
  </record>

  <!-- (De aquí hacia abajo deja tus plantillas tal como ya están) -->
  <!-- common_label_content, liq_label_qr_doc, liq_label_code128_doc,
       common_sheet_grid, liq_sheet_qr_doc, liq_sheet_code128_doc -->
  <!-- ... -->
</odoo>
