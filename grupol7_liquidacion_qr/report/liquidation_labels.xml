<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Solo estilos del reporte -->
        <template id="report_liq_coupons_labels_styles">
            <t>
                <style type="text/css">
                    .g7-sheet {
                        width: 18cm;
                        margin: 0 auto;
                        font-family: "Helvetica", "Arial", sans-serif;
                    }
                    .g7-label {
                        width: 18cm;
                        height: 9cm;
                        border: 1px solid #000;
                        box-sizing: border-box;
                        padding: 0.7cm 0.9cm;
                        margin-bottom: 0.7cm;
                    }
                    .g7-label-inner {
                        display: flex;
                        flex-direction: row;
                    }
                    .g7-qr-box {
                        width: 6cm;
                        text-align: center;
                        font-size: 10pt;
                    }
                    .g7-qr-img {
                        border: 1px solid #000;
                        width: 5cm;
                        height: 5cm;
                        margin: 0.2cm auto 0.2cm auto;
                    }
                    .g7-qr-code {
                        font-size: 9pt;
                    }
                    .g7-info {
                        flex: 1;
                        padding-left: 0.7cm;
                    }
                    .g7-prod-name {
                        font-size: 16pt;
                        font-weight: bold;
                        line-height: 1.15;
                        margin-bottom: 0.8cm;
                    }
                    .g7-price-row {
                        margin-top: 0.5cm;
                        font-size: 14pt;
                        font-weight: bold;
                    }
                    .g7-price-row span.g7-legend {
                        font-weight: normal;
                        font-size: 11pt;
                        margin-left: 0.2cm;
                    }
                    .g7-meta {
                        margin-top: 0.5cm;
                        font-size: 9pt;
                    }
                    .g7-meta span {
                        white-space: nowrap;
                    }
                </style>
            </t>
        </template>

        <!-- Una etiqueta completa (se usa dos veces en la misma hoja) -->
        <template id="liq_coupon_single_label">
            <t t-call="grupol7_liquidacion_qr.report_liq_coupons_labels_styles"/>
            <div class="g7-sheet">
                <!-- Primera etiqueta -->
                <div class="g7-label">
                    <div class="g7-label-inner">
                        <div class="g7-qr-box">
                            <div>QR</div>
                            <div class="g7-qr-img">
                                <img t-att-src="'/report/barcode/QR/%s?width=256&amp;height=256' % (o.name or '')"
                                     style="width: 100%; height: 100%;"/>
                            </div>
                            <div class="g7-qr-code" t-esc="o.name"/>
                        </div>
                        <div class="g7-info">
                            <div class="g7-prod-name" t-esc="o.product_id.display_name"/>
                            <div class="g7-price-row">
                                <span>$ <t t-esc="'%0.2f' % (o.public_clearance_price or o.clearance_price or 0.0)"/></span>
                                <span class="g7-legend">precio al p&amp;uacute;blico</span>
                            </div>
                            <div class="g7-meta">
                                <span t-if="o.create_date">
                                    Creado: <t t-esc="o.create_date"/> por
                                    <t t-esc="o.create_uid.name or ''"/>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Segunda etiqueta (misma info) -->
                <div class="g7-label">
                    <div class="g7-label-inner">
                        <div class="g7-qr-box">
                            <div>QR</div>
                            <div class="g7-qr-img">
                                <img t-att-src="'/report/barcode/QR/%s?width=256&amp;height=256' % (o.name or '')"
                                     style="width: 100%; height: 100%;"/>
                            </div>
                            <div class="g7-qr-code" t-esc="o.name"/>
                        </div>
                        <div class="g7-info">
                            <div class="g7-prod-name" t-esc="o.product_id.display_name"/>
                            <div class="g7-price-row">
                                <span>$ <t t-esc="'%0.2f' % (o.public_clearance_price or o.clearance_price or 0.0)"/></span>
                                <span class="g7-legend">precio al p&amp;uacute;blico</span>
                            </div>
                            <div class="g7-meta">
                                <span t-if="o.create_date">
                                    Creado: <t t-esc="o.create_date"/> por
                                    <t t-esc="o.create_uid.name or ''"/>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </template>

        <!-- Plantilla principal del reporte (envuelve en <main> sin membrete) -->
        <template id="report_liq_coupon_qr_label2">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <div class="page">
                        <t t-call="grupol7_liquidacion_qr.liq_coupon_single_label"/>
                    </div>
                </t>
            </t>
        </template>

        <!-- Acción del reporte -->
        <record id="action_liq_coupon_qr_label2" model="ir.actions.report">
            <field name="name">Etiqueta QR</field>
            <field name="model">liquidation.coupon</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">grupol7_liquidacion_qr.report_liq_coupon_qr_label2</field>
            <field name="report_file">grupol7_liquidacion_qr.report_liq_coupon_qr_label2</field>
            <field name="print_report_name">'Etiqueta_QR_' + (object.name or '')</field>
        </record>

    </data>
</odoo>
