<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <!-- Acción de reporte (la misma que ya usa el botón) -->
    <report
        id="action_liq_coupon_qr_label2"
        model="liquidation.coupon"
        string="Etiquetas QR Liquidacion"
        report_type="qweb-pdf"
        name="grupol7_liquidacion_qr.report_liq_coupon_qr_label2"
        file="grupol7_liquidacion_qr.report_liq_coupon_qr_label2"
        print_report_name="'Etiqueta_QR_%s' % (object.name or '')"
    />

    <!-- Plantilla principal del reporte -->
    <template id="report_liq_coupon_qr_label2">
      <t t-call="web.basic_layout">
        <t t-set="page_title" t-value="'Etiquetas QR Liquidacion'"/>
        <main class="o_report_layout">

          <!-- Un documento por cupón -->
          <t t-foreach="docs" t-as="o">
            <t t-set="code_text" t-value="(o.name or '').strip()"/>
            <t t-set="price_text" t-value="'$ %0.2f' % (o.public_clearance_price or 0.0)"/>

            <!-- Página con dos etiquetas (una debajo de otra) -->
            <div class="page"
                 style="width:200mm;height:100mm;box-sizing:border-box;
                        padding:10mm;display:flex;flex-direction:column;
                        justify-content:flex-start;">

              <!-- ===== Etiqueta 1 ===== -->
              <div style="display:flex;flex-direction:column;
                          align-items:flex-start;text-align:left;
                          max-width:160mm;margin-bottom:10mm;">

                <!-- QR: solo el codigo del cupon -->
                <img t-att-src="'/report/barcode/QR/' + code_text + '?width=420&amp;height=420'"
                     style="width:45mm;height:45mm;margin-bottom:3mm;"/>

                <!-- Codigo -->
                <div style="font-size:18pt;margin-bottom:2mm;" t-esc="code_text"/>

                <!-- Producto -->
                <div style="font-size:14pt;margin-bottom:2mm;"
                     t-esc="o.product_id.display_name or ''"/>

                <!-- Precio al publico (sin acentos para evitar problemas de encoding) -->
                <div style="font-size:18pt;margin-bottom:2mm;">
                  <b t-esc="price_text"/> <span>precio al publico</span>
                </div>

                <!-- Fecha y usuario que creo el cupon -->
                <div style="font-size:10pt;margin-top:1mm;"
                     t-esc="'Creado: %s por %s' % (
                       (o.create_date and o.create_date.strftime('%d/%m/%Y %H:%M') or ''),
                       (o.create_uid and o.create_uid.name or '')
                     )"/>
              </div>

              <!-- ===== Etiqueta 2 (misma info) ===== -->
              <div style="display:flex;flex-direction:column;
                          align-items:flex-start;text-align:left;
                          max-width:160mm;">

                <img t-att-src="'/report/barcode/QR/' + code_text + '?width=420&amp;height=420'"
                     style="width:45mm;height:45mm;margin-bottom:3mm;"/>

                <div style="font-size:18pt;margin-bottom:2mm;" t-esc="code_text"/>

                <div style="font-size:14pt;margin-bottom:2mm;"
                     t-esc="o.product_id.display_name or ''"/>

                <div style="font-size:18pt;margin-bottom:2mm;">
                  <b t-esc="price_text"/> <span>precio al publico</span>
                </div>

                <div style="font-size:10pt;margin-top:1mm;"
                     t-esc="'Creado: %s por %s' % (
                       (o.create_date and o.create_date.strftime('%d/%m/%Y %H:%M') or ''),
                       (o.create_uid and o.create_uid.name or '')
                     )"/>
              </div>

            </div>
          </t>

        </main>
      </t>
    </template>

  </data>
</odoo>
