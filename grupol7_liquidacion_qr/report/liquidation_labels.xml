  <!-- ========================= -->
  <!-- Papel 205x105 mm (20.5x10.5 cm) -->
  <record id="paperformat_liq_label_205x105" model="report.paperformat">
    <field name="name">LIQ 205x105</field>
    <field name="format">custom</field>
    <field name="page_width">205</field>
    <field name="page_height">105</field>
    <field name="margin_top">5</field>
    <field name="margin_bottom">5</field>
    <field name="margin_left">6</field>
    <field name="margin_right">6</field>
    <field name="orientation">Landscape</field>
  </record>

  <!-- ============ Code128 x2 en la misma hoja ============ -->
  <template id="liq_label_code128_205x105_double_doc">
    <t t-call="web.basic_layout">
      <t t-foreach="docs" t-as="o">
        <div class="page" style="width:205mm;height:105mm;box-sizing:border-box;padding:6mm;">
          <t t-set="code_text">'LIQ/' + o.name</t>
          <t t-set="price_text">'$ %0.2f' % (o.clearance_price or 0.0)"></t>

          <!-- Panel 1 (arriba) -->
          <div style="height:48%;border-bottom:1px dashed #999;display:flex;flex-direction:column;justify-content:center;">
            <img t-att-src="'/report/barcode/Code128/' + code_text + '?width=1000&amp;height=160'"
                 style="width:100%;height:16mm;object-fit:contain;"/>
            <div style="font-size:18pt;text-align:center;margin-top:2mm;" t-esc="code_text"/>
            <div style="font-size:14pt;text-align:center;margin-top:1mm;" t-esc="o.product_id.display_name or ''"/>
            <div style="font-size:18pt;text-align:center;margin-top:2mm;"><b t-esc="price_text"/></div>
            <div style="font-size:10pt;text-align:center;margin-top:1mm;"
                 t-esc="'Creado: %s por %s' % ((o.create_date and o.create_date.strftime('%d/%m/%Y %H:%M') or ''), (o.create_uid and o.create_uid.name or ''))"/>
            <div style="margin-top:3mm;display:flex;gap:8mm;justify-content:center;align-items:flex-end;">
              <div style="width:70mm;border-top:1px solid #000;text-align:center;font-size:10pt;padding-top:1mm;">Firma</div>
              <div style="width:40mm;border-top:1px solid #000;text-align:center;font-size:10pt;padding-top:1mm;">Fecha</div>
            </div>
          </div>

          <!-- Panel 2 (abajo) -->
          <div style="height:48%;display:flex;flex-direction:column;justify-content:center;">
            <img t-att-src="'/report/barcode/Code128/' + code_text + '?width=1000&amp;height=160'"
                 style="width:100%;height:16mm;object-fit:contain;"/>
            <div style="font-size:18pt;text-align:center;margin-top:2mm;" t-esc="code_text"/>
            <div style="font-size:14pt;text-align:center;margin-top:1mm;" t-esc="o.product_id.display_name or ''"/>
            <div style="font-size:18pt;text-align:center;margin-top:2mm;"><b t-esc="price_text"/></div>
            <div style="font-size:10pt;text-align:center;margin-top:1mm;"
                 t-esc="'Creado: %s por %s' % ((o.create_date and o.create_date.strftime('%d/%m/%Y %H:%M') or ''), (o.create_uid and o.create_uid.name or ''))"/>
            <div style="margin-top:3mm;display:flex;gap:8mm;justify-content:center;align-items:flex-end;">
              <div style="width:70mm;border-top:1px solid #000;text-align:center;font-size:10pt;padding-top:1mm;">Firma</div>
              <div style="width:40mm;border-top:1px solid #000;text-align:center;font-size:10pt;padding-top:1mm;">Fecha</div>
            </div>
          </div>
        </div>
      </t>
    </t>
  </template>

