<odoo>
    <data>

        <!-- Estilos del reporte: sin cabecera/footers y layout de etiquetas -->
        <template id="report_liq_coupons_labels_styles" inherit_id="web.report_layout">
            <xpath expr="//head" position="inside">
                <style type="text/css">
                    .header, .footer {
                        display: none !important;
                    }

                    .qr-label-page {
                        width: 100mm;
                        height: 200mm;
                        margin: 0 auto;
                        padding: 4mm;
                        box-sizing: border-box;
                        font-family: "Helvetica", "Arial", sans-serif;
                        font-size: 9pt;
                    }

                    .qr-label {
                        box-sizing: border-box;
                        border: 0.5pt solid #000;
                        width: 100%;
                        height: 50%;
                        padding: 4mm 5mm;
                        display: flex;
                        flex-direction: row;
                        align-items: flex-start;
                    }

                    .qr-label + .qr-label {
                        margin-top: 5mm;
                    }

                    .qr-left {
                        width: 40mm;
                        text-align: center;
                    }

                    .qr-left-title {
                        font-size: 8pt;
                        margin-bottom: 1mm;
                    }

                    .qr-left img {
                        width: 35mm;
                        height: 35mm;
                        border: 0.5pt solid #000;
                    }

                    .qr-code-text {
                        margin-top: 1mm;
                        font-size: 8pt;
                    }

                    .qr-right {
                        flex: 1;
                        padding-left: 5mm;
                    }

                    .qr-product {
                        font-size: 13pt;
                        font-weight: bold;
                        line-height: 1.25;
                    }

                    .qr-price {
                        margin-top: 6mm;
                        font-size: 14pt;
                        font-weight: bold;
                    }

                    .qr-price span.label {
                        font-size: 10pt;
                        font-weight: normal;
                        margin-left: 2mm;
                    }

                    .qr-meta {
                        margin-top: 4mm;
                        font-size: 7pt;
                    }
                </style>
            </xpath>
        </template>

        <!-- Una etiqueta -->
        <template id="liq_coupon_single_label">
            <div class="qr-label">
                <div class="qr-left">
                    <div class="qr-left-title">QR</div>
                    <img t-att-src="'/report/barcode/?type=QR&amp;value=%s&amp;width=256&amp;height=256' % ((o.name or '').strip())"/>
                    <div class="qr-code-text" t-esc="o.name or ''"/>
                </div>
                <div class="qr-right">
                    <div class="qr-product" t-esc="o.product_id.display_name or ''"/>
                    <div class="qr-price">
                        <span>
                            $ <t t-esc="'%0.2f' % (o.public_clearance_price or o.clearance_price or 0.0)"/>
                        </span>
                        <span class="label">precio al p&#250;blico</span>
                    </div>
                    <div class="qr-meta">
                        <t t-set="dt" t-value="o.create_date"/>
                        <span>Creado: </span>
                        <span t-esc="dt and dt.strftime('%d/%m/%Y %H:%M') or ''"/>
                        <span> por </span>
                        <span t-esc="o.create_uid and o.create_uid.name or ''"/>
                    </div>
                </div>
            </div>
        </template>

        <!-- Reporte principal: 2 etiquetas por página -->
        <template id="report_liq_coupon_qr_label2">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <div class="page qr-label-page">
                        <t t-call="grupol7_liquidacion_qr.liq_coupon_single_label"/>
                        <t t-call="grupol7_liquidacion_qr.liq_coupon_single_label"/>
                    </div>
                </t>
            </t>
        </template>

        <!-- Acción de reporte -->
        <report
            id="action_liq_coupon_qr_label2"
            model="liquidation.coupon"
            string="Etiquetas de liquidación QR"
            report_type="qweb-pdf"
            name="grupol7_liquidacion_qr.report_liq_coupon_qr_label2"
            file="grupol7_liquidacion_qr.report_liq_coupon_qr_label2"
            print_report_name="'Etiqueta_QR_%s' % (object.name or '')"
        />
    </data>
</odoo>
