  <record id="action_liq_coupon_print_label_code128" model="ir.actions.report">
    <field name="name">Etiqueta LIQ (Code128)</field>
    <field name="model">liquidation.coupon</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">grupol7_liquidacion_qr.liq_label_code128_doc</field>
    <field name="report_file">grupol7_liquidacion_qr.liq_label_code128_doc</field>
    <field name="paperformat_id" ref="grupol7_liquidacion_qr.paperformat_liq_label_30x25"/>
    <field name="print_report_name">'Etiqueta_LIQ_Code128_%s' % (object.name)</field>
