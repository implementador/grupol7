<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Formato de papel 10 x 20 cm -->
    <record id="paperformat_liq_coupon_10x20" model="report.paperformat">
        <field name="name">Cupón 10x20 cm</field>
        <!-- medidas en milímetros -->
        <field name="page_width">100</field>
        <field name="page_height">200</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <!-- Plantilla: 2 etiquetas por hoja, una debajo de la otra -->
    <template id="report_liq_coupon_qr_label2">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="o">
                <!-- CONTENEDOR DE UNA ETIQUETA (10 x 20 cm) -->
                <div style="
                    width: 100mm;
                    height: 200mm;
                    border: 1px solid #000;
                    box-sizing: border-box;
                    padding: 5mm;
                    margin: 0 auto 10mm auto;
                    page-break-inside: avoid;
                ">
                    <!-- BLOQUE SUPERIOR: QR + texto -->
                    <div style="display: flex; flex-direction: row;">
                        <!-- Caja del QR -->
                        <div style="
                            width: 40mm;
                            height: 40mm;
                            border: 1px solid #000;
                            text-align: center;
                            font-size: 8pt;
                        ">
                            <div>QR</div>
                            <!-- QR REAL usando el código del cupón (solo letras/números) -->
                            <img
                                t-att-src="'/report/barcode/?type=QR&amp;value=%s&amp;width=400&amp;height=400&amp;humanreadable=0' % (o.name or '')"
                                style="width: 100%; height: 100%;"
                            />
                        </div>

                        <!-- Datos del producto -->
                        <div style="flex: 1; padding-left: 5mm;">
                            <!-- Código del cupón -->
                            <div style="font-size: 10pt; margin-bottom: 2mm;" t-esc="o.name"/>
                            <!-- Nombre del producto -->
                            <div style="
                                font-size: 16pt;
                                font-weight: bold;
                                line-height: 1.2;
                            "
                                 t-esc="o.product_id.display_name or ''"/>
                        </div>
                    </div>

                    <!-- PRECIO AL PUBLICO (con IVA) -->
                    <div style="
                        margin-top: 15mm;
                        font-size: 14pt;
                        font-weight: bold;
                    ">
                        <span>$ </span>
                        <span t-esc="'%0.2f' % (o.public_clearance_price or 0.0)"/>
                        <span> precio al publico</span>
                    </div>

                    <!-- FECHA Y USUARIO QUE HIZO EL CUPÓN -->
                    <div style="margin-top: 5mm; font-size: 8pt;">
                        <span t-if="o.create_date">
                            Creado:
                            <t t-esc="o.create_date.strftime('%d/%m/%Y %H:%M')"/>
                        </span>
                        <span t-if="o.create_uid">
                            por
                            <t t-esc="o.create_uid.name"/>
                        </span>
                    </div>
                </div>
            </t>
        </t>
    </template>

    <!-- Acción del reporte -->
    <report
        id="action_liq_coupon_qr_label2"
        model="liquidation.coupon"
        string="Cupones de liquidación (2 etiquetas)"
        report_type="qweb-pdf"
        name="grupol7_liquidacion_qr.report_liq_coupon_qr_label2"
        file="grupol7_liquidacion_qr.report_liq_coupon_qr_label2"
        paperformat="grupol7_liquidacion_qr.paperformat_liq_coupon_10x20"
    />
</odoo>
