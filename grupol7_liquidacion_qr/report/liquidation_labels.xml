<odoo>

  <!-- Acción del reporte PDF -->
  <report
      id="action_liq_coupon_qr_label2"
      model="liquidation.coupon"
      string="Cupón de liquidación (QR)"
      report_type="qweb-pdf"
      name="grupol7_liquidacion_qr.report_liq_coupon_qr_label2"
      file="grupol7_liquidacion_qr.report_liq_coupon_qr_label2"
      print_report_name="'QR_' + (object and object[0].name or '')"
  />

  <!-- Plantilla QWeb del reporte -->
  <template id="report_liq_coupon_qr_label2" t-name="grupol7_liquidacion_qr.report_liq_coupon_qr_label2">
    <t t-call="web.html_container">
      <t t-set="docs" t-value="docs"/>

      <style type="text/css">
        @page {
          /* 10 cm x 20 cm */
          size: 100mm 200mm;
          margin: 4mm;
        }

        .g7_label_page {
          width: 92mm;
          height: 192mm;
          display: flex;
          flex-direction: column;
          justify-content: space-between; /* una etiqueta arriba y otra abajo */
          font-family: Arial, sans-serif;
        }

        .g7_coupon_label {
          display: flex;
          flex-direction: row;
          align-items: flex-start;
        }

        .g7_coupon_qr {
          width: 35mm;
          height: 35mm;
          margin-right: 4mm;
        }

        .g7_coupon_text {
          font-size: 9pt;
        }

        .g7_coupon_name {
          font-weight: bold;
        }

        .g7_coupon_product {
          font-size: 8pt;
        }

        .g7_coupon_price {
          margin-top: 2mm;
          font-size: 10pt;
          font-weight: bold;
        }
      </style>

      <!-- Una página por cupón -->
      <t t-foreach="docs" t-as="o">
        <div class="g7_label_page">

          <!-- Primera etiqueta (arriba) -->
          <div class="g7_coupon_label">
            <img t-att-src="'/report/barcode/QR/%s' % (o.name or '')"
                 class="g7_coupon_qr"/>
            <div class="g7_coupon_text">
              <div class="g7_coupon_name" t-esc="o.name"/>
              <div class="g7_coupon_product" t-esc="o.product_id.display_name"/>
              <div class="g7_coupon_price">
                <span>$ </span>
                <span t-esc="'%0.2f' % (o.public_clearance_price or o.clearance_price or 0.0)"/>
              </div>
            </div>
          </div>

          <!-- Segunda etiqueta (abajo) -->
          <div class="g7_coupon_label">
            <img t-att-src="'/report/barcode/QR/%s' % (o.name or '')"
                 class="g7_coupon_qr"/>
            <div class="g7_coupon_text">
              <div class="g7_coupon_name" t-esc="o.name"/>
              <div class="g7_coupon_product" t-esc="o.product_id.display_name"/>
              <div class="g7_coupon_price">
                <span>$ </span>
                <span t-esc="'%0.2f' % (o.public_clearance_price or o.clearance_price or 0.0)"/>
              </div>
            </div>
          </div>

          <!-- salto de página para el siguiente cupón -->
          <div style="page-break-after: always;"></div>
        </div>
      </t>
    </t>
  </template>

</odoo>
