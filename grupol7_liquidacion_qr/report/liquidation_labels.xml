<odoo>

  <!-- Papel 30x25 mm -->
  <record id="paperformat_liq_label_30x25" model="report.paperformat">
    <field name="name">LIQ 30x25</field>
    <field name="format">custom</field>
    <field name="page_width">30</field>
    <field name="page_height">25</field>
    <field name="margin_top">2</field>
    <field name="margin_bottom">2</field>
    <field name="margin_left">2</field>
    <field name="margin_right">2</field>
    <field name="orientation">Portrait</field>
  </record>

  <!-- Template: QR -->
  <template id="liq_label_qr_doc">
    <t t-call="web.basic_layout">
      <div class="page" style="width:30mm;height:25mm;box-sizing:border-box;padding:1mm;font-size:9pt;">
        <t t-foreach="docs" t-as="o">
          <div style="text-align:center;page-break-inside:avoid;display:inline-block;width:28mm;height:23mm">
            <img t-att-src="'/report/barcode/QR/' + ('LIQ/' + o.name) + '?width=260&amp;height=260'"
                 style="width:22mm;height:22mm"/>
            <div style="font-size:8pt" t-esc="'LIQ/' + o.name"/>
            <div style="font-size:7pt" t-esc="(o.product_id.display_name or '')[:32]"/>
            <div style="font-size:8pt"><b t-esc="('$ %0.2f' % o.clearance_price)"/></div>

            <div style="font-size:6.5pt;margin-top:0.8mm;white-space:nowrap;">
              <t t-esc="'Creado: %s por %s' % ((o.create_date and o.create_date.strftime('%d/%m/%Y %H:%M') or ''), o.create_uid.name)"/>
            </div>
            <div style="margin-top:0.6mm;height:7mm;border:0.25mm solid #000;border-radius:1mm;"></div>
            <div style="text-align:center;font-size:6pt;line-height:1;">Firma</div>

          </div>
        </t>
      </div>
    </t>
  </template>

  <record id="action_liq_coupon_print_label_qr" model="ir.actions.report">
    <field name="name">Etiqueta LIQ (QR)</field>
    <field name="model">liquidation.coupon</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">grupol7_liquidacion_qr.liq_label_qr_doc</field>
    <field name="report_file">grupol7_liquidacion_qr.liq_label_qr_doc</field>
    <field name="paperformat_id" ref="grupol7_liquidacion_qr.paperformat_liq_label_30x25"/>
    <field name="print_report_name">'Etiqueta_LIQ_QR_%s' % (object.name)</field>
  </record>

