<odoo>
    <!-- Plantilla de estilos (vacía, sólo para mantener el id) -->
    <template id="report_liq_coupons_labels_styles">
        <t t-raw="''"/>
    </template>

    <!-- Reporte principal: 2 etiquetas QR en una hoja de 10x20 cm -->
    <template id="report_liq_coupon_qr_label2">
        <t t-name="grupol7_liquidacion_qr.report_liq_coupon_qr_label2">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <div class="page">
                        <style type="text/css">
                            @page {
                                size: 10cm 20cm;
                                margin: 0cm;
                            }
                            .liq-page {
                                width: 10cm;
                                height: 20cm;
                                box-sizing: border-box;
                                padding: 0.5cm 0.7cm;
                                font-family: "Helvetica", "Arial", sans-serif;
                                font-size: 11pt;
                            }
                            .liq-label {
                                width: 100%;
                                height: 9cm;
                                box-sizing: border-box;
                                border: 1px solid #000000;
                                padding: 0.4cm 0.5cm;
                                display: flex;
                                flex-direction: row;
                                align-items: center;
                            }
                            /* Espacio entre las dos etiquetas */
                            .liq-label + .liq-label {
                                margin-top: 1cm;
                            }
                            .liq-qr {
                                flex: 0 0 4cm;
                                text-align: center;
                            }
                            .liq-qr img {
                                width: 3.5cm;
                                height: 3.5cm;
                            }
                            .liq-qr-code {
                                margin-top: 0.2cm;
                                font-size: 10pt;
                                word-break: break-all;
                            }
                            .liq-info {
                                flex: 1;
                                padding-left: 0.4cm;
                            }
                            .liq-title {
                                font-size: 14pt;
                                font-weight: bold;
                                text-transform: uppercase;
                                margin-bottom: 0.2cm;
                            }
                            .liq-line {
                                margin-bottom: 0.15cm;
                            }
                            .liq-price {
                                margin-top: 0.35cm;
                                font-size: 13pt;
                                font-weight: bold;
                            }
                            .liq-price small {
                                font-size: 9pt;
                                font-weight: normal;
                            }
                        </style>

                        <div class="liq-page">
                            <!-- Etiqueta 1 (arriba) -->
                            <div class="liq-label">
                                <div class="liq-qr">
                                    <!-- QR: sólo el código del cupón, sin texto extra -->
                                    <img t-att-src="'/report/barcode/QR/%s/300/300' % (o.name or '')" alt="QR"/>
                                    <div class="liq-qr-code">
                                        <span t-esc="o.name"/>
                                    </div>
                                </div>
                                <div class="liq-info">
                                    <div class="liq-title">
                                        <span t-esc="o.product_id.display_name or ''"/>
                                    </div>
                                    <!-- Línea de ubicación eliminada porque el campo no existe -->
                                    <div class="liq-price">
                                        <span>$</span>
                                        <!-- Precio al público con IVA -->
                                        <span t-esc="'%0.2f' % (o.public_clearance_price or 0.0)"/>
                                        <small> precio al público</small>
                                    </div>
                                </div>
                            </div>

                            <!-- Etiqueta 2 (abajo, igual que la primera) -->
                            <div class="liq-label">
                                <div class="liq-qr">
                                    <img t-att-src="'/report/barcode/QR/%s/300/300' % (o.name or '')" alt="QR"/>
                                    <div class="liq-qr-code">
                                        <span t-esc="o.name"/>
                                    </div>
                                </div>
                                <div class="liq-info">
                                    <div class="liq-title">
                                        <span t-esc="o.product_id.display_name or ''"/>
                                    </div>
                                    <!-- Línea de ubicación eliminada porque el campo no existe -->
                                    <div class="liq-price">
                                        <span>$</span>
                                        <span t-esc="'%0.2f' % (o.public_clearance_price or 0.0)"/>
                                        <small> precio al público</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Acción de reporte que usa el template anterior -->
    <report
        id="action_liq_coupon_qr_label2"
        model="liquidation.coupon"
        string="Etiquetas cupón QR"
        report_type="qweb-pdf"
        name="grupol7_liquidacion_qr.report_liq_coupon_qr_label2"
        file="grupol7_liquidacion_qr.report_liq_coupon_qr_label2"
        print_report_name="'Etiqueta_QR_%s' % (object.name or '')"
    />
</odoo>
