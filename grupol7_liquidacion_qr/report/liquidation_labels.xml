<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>

    <!-- Reporte: 2 etiquetas por cupón, una debajo de otra -->
    <template id="report_liq_coupon_qr_label2">
      <t t-call="web.external_layout">
        <div class="page" style="margin:0; padding:0;">
          <t t-foreach="docs" t-as="o">

            <!-- PRIMERA ETIQUETA (10 x ~9.5 cm) -->
            <div style="width:100mm; height:95mm; margin:0 auto 10mm auto; padding:0;">
              <div style="display:flex; flex-direction:row; align-items:flex-start;">
                <div style="width:38mm;">
                  <!-- QR solo con el código del cupón -->
                  <img
                    t-att-src="'/report/barcode/QR/%s' % ((o.name or '').strip())"
                    style="width:36mm; height:36mm;"
                  />
                </div>
                <div style="padding-left:4mm; font-size:9pt; line-height:1.2;">
                  <div style="font-weight:bold; font-size:9pt;" t-esc="o.name"/>
                  <div style="font-size:8pt;" t-esc="o.product_id.display_name or ''"/>
                  <div style="margin-top:2mm; font-weight:bold; font-size:10pt;">
                    <span>$ </span>
                    <span t-esc="'%0.2f' % (o.public_clearance_price or o.clearance_price or 0.0)"/>
                  </div>
                </div>
              </div>
            </div>

            <!-- SEGUNDA ETIQUETA (misma info) -->
            <div style="width:100mm; height:95mm; margin:0 auto 10mm auto; padding:0;">
              <div style="display:flex; flex-direction:row; align-items:flex-start;">
                <div style="width:38mm;">
                  <img
                    t-att-src="'/report/barcode/QR/%s' % ((o.name or '').strip())"
                    style="width:36mm; height:36mm;"
                  />
                </div>
                <div style="padding-left:4mm; font-size:9pt; line-height:1.2;">
                  <div style="font-weight:bold; font-size:9pt;" t-esc="o.name"/>
                  <div style="font-size:8pt;" t-esc="o.product_id.display_name or ''"/>
                  <div style="margin-top:2mm; font-weight:bold; font-size:10pt;">
                    <span>$ </span>
                    <span t-esc="'%0.2f' % (o.public_clearance_price or o.clearance_price or 0.0)"/>
                  </div>
                </div>
              </div>
            </div>

            <!-- Salto de página después de las 2 etiquetas -->
            <div style="page-break-after:always;"/>
          </t>
        </div>
      </t>
    </template>

    <!-- Acción del reporte -->
    <report
        id="action_liq_coupon_qr_label2"
        model="liquidation.coupon"
        string="Etiquetas de cupones de liquidación (QR)"
        report_type="qweb-pdf"
        name="grupol7_liquidacion_qr.report_liq_coupon_qr_label2"
        file="grupol7_liquidacion_qr.report_liq_coupon_qr_label2"
        print_report_name="'Cupones_QR_%s' % (object.name or '')"
    />
  </data>
</odoo>
