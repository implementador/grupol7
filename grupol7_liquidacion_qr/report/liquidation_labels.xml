<odoo>
  <!-- Formato 30x25 mm para stickers -->
  <record id="paperformat_liq_label_30x25" model="report.paperformat">
    <field name="name">LIQ Label 30x25</field>
    <field name="default" eval="False"/>
    <field name="format">custom</field>
    <field name="page_width">30</field>
    <field name="page_height">25</field>
    <field name="orientation">Portrait</field>
    <field name="margin_top">1</field>
    <field name="margin_bottom">1</field>
    <field name="margin_left">1</field>
    <field name="margin_right">1</field>
    <field name="dpi">96</field>
  </record>

  <!-- Acciones: QR y Code128 -->
  <report id="action_liq_coupon_print_label_qr"
          model="liquidation.coupon"
          string="Etiqueta LIQ (QR)"
          report_type="qweb-pdf"
          name="grupol7_liquidacion_qr.liq_label_qr_doc"
          paperformat="paperformat_liq_label_30x25"/>

  <report id="action_liq_coupon_print_label_code128"
          model="liquidation.coupon"
          string="Etiqueta LIQ (Code128)"
          report_type="qweb-pdf"
          name="grupol7_liquidacion_qr.liq_label_code128_doc"
          paperformat="paperformat_liq_label_30x25"/>

  <!-- Plantilla QR: sin header/footer; solo el QR centrado -->
  <template id="liq_label_qr_doc">
    <t t-call="web.basic_layout">
      <div class="page">
        <t t-foreach="docs" t-as="o">
          <div style="width:28mm;height:23mm;display:flex;align-items:center;justify-content:center;margin:0 auto;">
            <img t-att-src="'/report/barcode/?type=QR&amp;value=%s&amp;width=256&amp;height=256' % ('LIQ/' + o.name)"
                 style="width:22mm;height:22mm;"/>
          </div>
        </t>
      </div>
    </t>
  </template>

  <!-- Plantilla Code128: barra y el texto pequeño abajo -->
  <template id="liq_label_code128_doc">
    <t t-call="web.basic_layout">
      <div class="page">
        <t t-foreach="docs" t-as="o">
          <div style="width:28mm;height:23mm;display:flex;flex-direction:column;align-items:center;justify-content:center;margin:0 auto;">
            <img t-att-src="'/report/barcode/?type=Code128&amp;value=%s&amp;width=280&amp;height=90&amp;humanreadable=0' % ('LIQ/' + o.name)"
                 style="width:26mm;height:10mm;"/>
            <div style="font-size:7px;text-align:center;line-height:1;margin-top:1mm;">
              LIQ/<t t-esc="o.name"/>
            </div>
          </div>
        </t>
      </div>
    </t>
  </template>
</odoo>
