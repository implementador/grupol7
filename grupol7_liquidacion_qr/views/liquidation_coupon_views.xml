<odoo>
<field name="model">liquidation.coupon</field>
<field name="arch" type="xml">
<form string="Cupón de liquidación">
<sheet>
<group>
<group>
<field name="name" readonly="1"/>
<field name="product_id"/>
<field name="lot_id"/>
<field name="damage_grade"/>
</group>
<group>
<field name="clearance_price"/>
<field name="expiration_date"/>
<field name="state"/>
<field name="company_id"/>
</group>
</group>
<group>
<field name="pos_allowed_ids" widget="many2many_tags"/>
<field name="notes"/>
</group>
<notebook>
<page string="Trazabilidad">
<group>
<field name="pos_order_id"/>
<field name="pos_order_line_id"/>
<field name="sale_order_id"/>
<field name="sale_order_line_id"/>
</group>
</page>
</notebook>
</sheet>
<header>
<button name="%(action_liq_coupon_print_labels)d" string="Imprimir etiqueta" type="action" class="btn-primary"/>
</header>
</form>
</field>
</record>


<!-- Acción y menú -->
<record id="action_liq_coupon" model="ir.actions.act_window">
<field name="name">Cupones de liquidación</field>
<field name="res_model">liquidation.coupon</field>
<field name="view_mode">tree,form</field>
</record>


<menuitem id="menu_liq_root" name="Liquidación" parent="stock.menu_stock_root" sequence="80"/>
<menuitem id="menu_liq_coupon" name="Cupones" parent="menu_liq_root" action="action_liq_coupon"/>
<menuitem id="menu_liq_generate" name="Generar cupones" parent="menu_liq_root" action="action_open_liq_generate_wizard"/>


<!-- Acción para abrir wizard -->
<record id="action_open_liq_generate_wizard" model="ir.actions.act_window">
<field name="name">Generar cupones LIQ</field>
<field name="res_model">liq.generate.coupons.wizard</field>
<field name="view_mode">form</field>
<field name="target">new</field>
</record>
</odoo>
