<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================ -->
    <!-- CLIENTES API                                                      -->
    <!-- ================================================================ -->

    <record id="view_l7_stock_api_client_tree" model="ir.ui.view">
        <field name="name">l7.stock.api.client.tree</field>
        <field name="model">l7.stock.api.client</field>
        <field name="arch" type="xml">
            <tree>
                <field name="active"/>
                <field name="name"/>
                <field name="company_id"/>
                <field name="token_last4"/>
                <field name="requests_per_minute"/>
                <field name="max_page_size"/>
                <field name="last_used_at"/>
            </tree>
        </field>
    </record>

    <record id="view_l7_stock_api_client_form" model="ir.ui.view">
        <field name="name">l7.stock.api.client.form</field>
        <field name="model">l7.stock.api.client</field>
        <field name="arch" type="xml">
            <form string="Cliente API de existencias">

                <header>
                    <button
                        name="action_generate_token"
                        string="Generar / renovar token"
                        type="object"
                        class="oe_highlight"
                        confirm="El token anterior dejara de funcionar. ¿Continuar?"
                    />

                    <button
                        name="action_revoke_token"
                        string="Revocar token"
                        type="object"
                        confirm="¿Seguro que deseas revocar el token?"
                    />
                </header>

                <sheet>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>

                        <group string="Autorizacion">

                            <field name="active"/>

                            <field
                                name="company_id"
                                options="{'no_create': True, 'no_create_edit': True}"
                            />

                            <field
                                name="token_last4"
                                readonly="1"
                            />

                            <field
                                name="last_used_at"
                                readonly="1"
                            />

                            <field
                                name="token_hash"
                                invisible="1"
                            />

                        </group>

                        <group string="Limites">

                            <field name="requests_per_minute"/>

                            <field name="max_page_size"/>

                        </group>

                    </group>

                    <group string="Seguridad">
                        <div colspan="2" class="alert alert-info" role="alert">
                            La empresa se obtiene exclusivamente de este registro.
                            El consumidor de la API no puede seleccionar otra empresa
                            mediante parametros HTTP.
                        </div>
                    </group>

                    <group string="Notas">
                        <field
                            name="notes"
                            nolabel="1"
                            placeholder="Proveedor, responsable, finalidad de la integracion, etc."
                        />
                    </group>

                </sheet>

            </form>
        </field>
    </record>

    <record id="action_l7_stock_api_client" model="ir.actions.act_window">
        <field name="name">Clientes API</field>
        <field name="res_model">l7.stock.api.client</field>
        <field name="view_mode">tree,form</field>
    </record>


    <!-- ================================================================ -->
    <!-- LOGS                                                              -->
    <!-- ================================================================ -->

    <record id="view_l7_stock_api_log_tree" model="ir.ui.view">
        <field name="name">l7.stock.api.log.tree</field>
        <field name="model">l7.stock.api.log</field>
        <field name="arch" type="xml">
            <tree
                string="Bitacora Stock API"
                create="false"
                edit="false"
            >
                <field name="requested_at"/>
                <field name="client_id"/>
                <field name="company_id"/>
                <field name="remote_ip"/>
                <field name="method"/>
                <field name="path"/>
                <field name="status_code"/>
                <field name="result_count"/>
                <field name="duration_ms"/>
            </tree>
        </field>
    </record>

    <record id="view_l7_stock_api_log_form" model="ir.ui.view">
        <field name="name">l7.stock.api.log.form</field>
        <field name="model">l7.stock.api.log</field>
        <field name="arch" type="xml">
            <form
                string="Consulta API"
                create="false"
                edit="false"
                delete="true"
            >
                <sheet>

                    <group>
                        <group>
                            <field name="requested_at"/>
                            <field name="client_id"/>
                            <field name="company_id"/>
                            <field name="remote_ip"/>
                        </group>

                        <group>
                            <field name="method"/>
                            <field name="path"/>
                            <field name="status_code"/>
                            <field name="result_count"/>
                            <field name="duration_ms"/>
                        </group>
                    </group>

                    <group>
                        <field name="query_string"/>
                        <field name="user_agent"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <record id="action_l7_stock_api_log" model="ir.actions.act_window">
        <field name="name">Bitacora</field>
        <field name="res_model">l7.stock.api.log</field>
        <field name="view_mode">tree,form</field>
    </record>


    <!-- ================================================================ -->
    <!-- MENUS                                                             -->
    <!-- ================================================================ -->

    <menuitem
        id="menu_l7_stock_api_root"
        name="L7 Stock API"
        sequence="95"
        groups="base.group_system"
    />

    <menuitem
        id="menu_l7_stock_api_client"
        name="Clientes API"
        parent="menu_l7_stock_api_root"
        action="action_l7_stock_api_client"
        sequence="10"
        groups="base.group_system"
    />

    <menuitem
        id="menu_l7_stock_api_log"
        name="Bitacora"
        parent="menu_l7_stock_api_root"
        action="action_l7_stock_api_log"
        sequence="20"
        groups="base.group_system"
    />

</odoo>
