<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_l7_insumos_report_tree" model="ir.ui.view">
        <field name="name">l7.insumos.report.tree</field>
        <field name="model">l7.insumos.report</field>
        <field name="arch" type="xml">
            <tree create="false" delete="false">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="movement_count"/>
                <field name="picking_count"/>
                <field name="total_amount"/>
                <field name="state"/>
                <field name="requested_by"/>
                <field name="create_date"/>
            </tree>
        </field>
    </record>

    <record id="view_l7_insumos_report_form" model="ir.ui.view">
        <field name="name">l7.insumos.report.form</field>
        <field name="model">l7.insumos.report</field>
        <field name="arch" type="xml">
            <form string="Reporte de gasto de insumos" create="false" delete="false">
                <header>
                    <button
                        name="action_download"
                        type="object"
                        string="Descargar Excel"
                        class="oe_highlight"
                        attrs="{'invisible': [('attachment_id', '=', False)]}"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,done,error"
                    />
                </header>

                <sheet>

                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_download"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-download"
                            attrs="{'invisible': [('attachment_id', '=', False)]}"
                        >
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">
                                    Descargar Excel
                                </span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Periodo">
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="requested_by"/>
                        </group>

                        <group string="Resultado">
                            <field name="movement_count"/>
                            <field name="picking_count"/>
                            <field name="total_amount"/>
                            <field name="safety_percent"/>
                            <field name="attachment_id" readonly="1"/>
                        </group>
                    </group>

                    <group attrs="{'invisible': [('error_message', '=', False)]}">
                        <field
                            name="error_message"
                            readonly="1"
                            nolabel="1"
                        />
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <record id="action_l7_insumos_report_history" model="ir.actions.act_window">
        <field name="name">Historial de reportes de insumos</field>
        <field name="res_model">l7.insumos.report</field>
        <field name="view_mode">tree,form</field>
        <field name="target">current</field>
    </record>

</odoo>
